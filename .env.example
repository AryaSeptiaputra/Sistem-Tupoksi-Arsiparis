# Production Environment Configuration
# Copy this file to .env and fill in your actual values

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# Format: mysql+pymysql://username:password@host:port/database
DATABASE_URL=mysql+pymysql://arsiparis_user:your_secure_password_here@localhost:3306/arsiparis_smk7

# ==========================================
# SECURITY CONFIGURATION
# ==========================================
# Generate strong random keys for production
# You can use: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_super_secure_jwt_secret_key_here_minimum_64_characters
SECRET_KEY=your_flask_secret_key_here_minimum_32_characters

# ==========================================
# APPLICATION CONFIGURATION
# ==========================================
FLASK_ENV=production
FLASK_DEBUG=0

# ==========================================
# LOGGING CONFIGURATION
# ==========================================
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/production.log

# ==========================================
# FILE UPLOAD CONFIGURATION
# ==========================================
MAX_CONTENT_LENGTH=16777216  # 16MB in bytes
UPLOAD_FOLDER=storage/documents
ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,jpg,jpeg,png

# ==========================================
# BACKUP CONFIGURATION
# ==========================================
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM

# ==========================================
# CACHE CONFIGURATION (Optional)
# ==========================================
# REDIS_URL=redis://localhost:6379/0
# CACHE_TYPE=redis

# ==========================================
# EMAIL CONFIGURATION (Optional)
# ==========================================
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password

# ==========================================
# MONITORING CONFIGURATION
# ==========================================
# SENTRY_DSN=your_sentry_dsn_here
# PROMETHEUS_ENABLED=true